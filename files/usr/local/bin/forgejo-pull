#!/usr/bin/env bash
# Managed by bundlewrap (bundles/forgejo, role "pull").
#
# Keeps one deploy target in sync with Forgejo. Called by
# forgejo-pull@<target>.timer with /etc/forgejo-pull/<target>.env:
#
#   TYPE=static  PACKAGE=<generic package>  DEST=/var/www/<site>
#       newest package version is verified, unpacked into DEST/releases/<version>
#       and DEST/current is switched to it atomically (nginx root = DEST/current).
#       The newest three releases are kept.
#   TYPE=git     REPO=<repo name>  DIR=/var/www/<checkout>  BRANCH=master
#                COMPOSE=true|false  REQUIRE_CI=true|false
#       checkout is moved to the branch head in Forgejo (only if CI is green when
#       REQUIRE_CI), then `docker compose up -d --build`. Untracked files such as
#       data directories are never touched: no `git clean`, ever.
#
# plus FORGEJO_URL, FORGEJO_OWNER, FORGEJO_TOKEN (read-only) from the shared
# /etc/forgejo-pull/forgejo.env. STATE_DIR holds the deployed version per target.
set -euo pipefail

api() { curl -sSf -H "Authorization: token ${FORGEJO_TOKEN}" "$@"; }
die() { echo "$*" >&2; exit 1; }

# Version names come from the package registry, which every workflow in the org can
# write to. Only the formats produced by the shared publish-site action are accepted
# (<UTC timestamp>-<short sha>, or a full sha from before 2026-10); nothing else is
# ever used to build a path.
VERSION_RE='^([0-9]{14}-[0-9a-f]{8}|[0-9a-f]{40})$'

case "${TYPE}" in

static)
    # inputs from the root-owned env file (bundlewrap); checked anyway against typos
    [[ "${DEST}" =~ ^/var/www/[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || die "DEST '${DEST}' is not /var/www/<name>, refusing"
    [[ "${PACKAGE}" =~ ^[A-Za-z0-9_-][A-Za-z0-9._+-]*$ ]]      || die "PACKAGE '${PACKAGE}' has unexpected characters, refusing"
    state="${STATE_DIR}/${PACKAGE}.version"

    # newest version of the generic package = last successful CI run
    version=$(api "${FORGEJO_URL}/api/v1/packages/${FORGEJO_OWNER}?type=generic&q=${PACKAGE}&limit=50" \
        | jq -r --arg p "${PACKAGE}" '[.[] | select(.name == $p)] | sort_by(.created_at) | last | .version // empty')
    [[ -n "${version}" ]] || { echo "no package ${PACKAGE} found"; exit 0; }
    [[ "${version}" =~ ${VERSION_RE} ]] || die "unexpected version '${version}' in the registry, refusing"
    [[ "$(cat "${state}" 2>/dev/null)" == "${version}" ]] && exit 0   # already deployed

    file=$(api "${FORGEJO_URL}/api/v1/packages/${FORGEJO_OWNER}/generic/${PACKAGE}/${version}/files")
    name=$(jq -r '.[0].name' <<<"${file}")
    sha=$(jq -r '.[0].sha256' <<<"${file}")
    [[ "${name}" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || die "unexpected file name '${name}', refusing"
    [[ "${sha}" =~ ^[0-9a-f]{64}$ ]]                 || die "unexpected checksum '${sha}', refusing"

    # bundlewrap creates DEST/current (bootstrap: `current -> .`); never touch anything else
    link="${DEST}/current"
    [[ -L "${link}" ]] || die "${link} is not a symlink, refusing (bootstrap missing?)"

    tmp=$(mktemp -d); trap 'rm -rf -- "${tmp}"' EXIT
    api -o "${tmp}/${name}" "${FORGEJO_URL}/api/packages/${FORGEJO_OWNER}/generic/${PACKAGE}/${version}/${name}"
    echo "${sha}  ${tmp}/${name}" | sha256sum -c --quiet

    # unpack next to the live release, so the switch below is a rename on one filesystem.
    # Versions are unique; an existing directory means something unexpected happened.
    release="${DEST}/releases/${version}"
    mkdir -- "${release}" || die "${release} already exists, refusing"
    tar -xzf "${tmp}/${name}" -C "${release}" --no-same-owner --no-same-permissions

    # A site is plain files and directories. Symlinks (e.g. index.html -> /etc/passwd,
    # which nginx would follow) or device files are refused.
    if [[ -n "$(find "${release}" ! -type f ! -type d -print -quit)" ]]; then
        rm -rf -- "${release}"; die "artifact ${version} contains symlinks or special files, refusing"
    fi
    [[ -f "${release}/index.html" ]] || { rm -rf -- "${release}"; die "artifact ${version} has no index.html, refusing"; }

    ln -sfn "releases/${version}" "${DEST}/.current.tmp"
    mv -T -- "${DEST}/.current.tmp" "${link}"   # atomic: requests see the old or the new release
    echo "${version}" > "${state}"
    echo "deployed ${PACKAGE} ${version}"

    # keep the newest three releases; only directories named exactly like a version,
    # directly in releases/, and never the one just deployed
    find "${DEST}/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' \
        | sort -rn | tail -n +4 | cut -d' ' -f2- \
        | while read -r old; do
              [[ "${old}" =~ ${VERSION_RE} && "${old}" != "${version}" ]] || continue
              rm -rf -- "${DEST}/releases/${old}"
          done
    ;;

git)
    cd "${DIR}"
    branch="${BRANCH:-master}"
    repo="${FORGEJO_URL}/${FORGEJO_OWNER}/${REPO}.git"

    # fetch the mirror; the token goes through a credential helper, not the command line
    git -c credential.helper='!f() { echo "username=token"; echo "password=${FORGEJO_TOKEN}"; }; f' \
        fetch --quiet "${repo}" "refs/heads/${branch}"
    want=$(git rev-parse FETCH_HEAD)
    have=$(git rev-parse HEAD)
    [[ "${want}" == "${have}" ]] && exit 0   # already deployed

    if [[ "${REQUIRE_CI:-false}" == "true" ]]; then
        # Latest run of every workflow for this commit must be green. (Commit statuses
        # would miss manually started runs; Forgejo records them only for push events.)
        verdict=$(api "${FORGEJO_URL}/api/v1/repos/${FORGEJO_OWNER}/${REPO}/actions/runs?head_sha=${want}&limit=50" \
            | jq -r '[.workflow_runs[]?] | if length == 0 then "no runs yet"
                     else (group_by(.workflow_id) | map(max_by(.id) | .status)
                           | if all(. == "success") then "success" else join(",") end) end')
        [[ "${verdict}" == "success" ]] || { echo "${want:0:10}: CI is '${verdict}', waiting"; exit 0; }
    fi

    # never overwrite hand-made changes on the host; fix them in git or revert them by hand
    if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
        echo "${DIR} has local modifications to tracked files, refusing to deploy" >&2
        git status --short --untracked-files=no >&2
        exit 1
    fi

    git reset --quiet --hard FETCH_HEAD        # tracked files only; pb_data & co stay untouched
    if [[ "${COMPOSE:-false}" == "true" ]]; then
        docker compose up -d --build --remove-orphans --quiet-pull
    fi
    echo "deployed ${REPO} ${have:0:10} -> ${want:0:10}"
    ;;

*)  echo "unknown TYPE ${TYPE}"; exit 1 ;;
esac
